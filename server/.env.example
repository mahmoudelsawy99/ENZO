PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/enzo
CLIENT_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-characters
SUPER_ADMIN_EMAIL=admin@enzo.local
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_NAME=Platform Admin
# Required before a tenant can store WhatsApp Cloud API credentials. At least 32 characters. Never commit a real key.
WHATSAPP_ENCRYPTION_KEY=
# Optional Mongo connection pool size. Default 10.
MONGO_POOL_SIZE=10
# Comma-separated browser origins when the API is called from more than one host.
# CLIENT_ORIGIN=https://app.example.com,https://admin.example.com
